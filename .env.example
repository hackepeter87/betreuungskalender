NODE_ENV=production
APP_RELEASE_VERSION=1.18.1
APP_RELEASE_DIR=/opt/svc_betreuung/betreuungskalender/releases/v1.18.1
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
AUTH_MODE=local
REQUIRE_AUTH=true
TRUST_PROXY_AUTH=false
TRUSTED_PROXY_CIDRS=
AUTH_LOGOUT_URL=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_GROUPS_CLAIM=groups
OIDC_USER_ID_HEADER=x-auth-request-user
OIDC_EMAIL_HEADER=x-auth-request-email
OIDC_DISPLAY_NAME_HEADER=x-auth-request-preferred-username
OIDC_GROUPS_HEADER=x-auth-request-groups
OIDC_ADMIN_GROUP=/betreuungskalender/admins
OIDC_PARENT_GROUP=/betreuungskalender/parents
OIDC_READONLY_GROUP=/betreuungskalender/readers
OIDC_REQUIRE_ROLE_CLAIM=false
OWNER_SETUP_TOKEN_FILE=/run/secrets/owner-setup-token
OWNER_SETUP_TOKEN_TTL_SECONDS=86400
SESSION_COOKIE_NAME=betreuungskalender_session
SESSION_TTL_SECONDS=2419200
RECOVERY_ADMIN_ENABLED=false
RECOVERY_ADMIN_USERNAME=breakglass
RECOVERY_ADMIN_INITIAL_PASSWORD_FILE=/run/secrets/recovery-admin-password
RECOVERY_ADMIN_INITIAL_PASSWORD=
RECOVERY_ADMIN_SESSION_COOKIE_NAME=betreuungskalender_recovery
RECOVERY_ADMIN_SESSION_TTL_SECONDS=900
WEB_PUSH_SUBJECT=mailto:admin@example.invalid
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,webpush.push.apple.com
INVITATION_EMAIL_ENABLED=false
INVITATION_PUBLIC_BASE_URL=https://betreuung.example.net
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALLOWED_ORIGIN=https://betreuung.example.net
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_SENSITIVE_MAX=5
RATE_LIMIT_EXPORT_MAX=15
RATE_LIMIT_WINDOW_MS=60000
DEMO_DATASETS_ENABLED=false
BACKUP_RETENTION_DAYS=14
