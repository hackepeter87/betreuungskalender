{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": ["replicaCount", "image", "runtime", "service", "ingress", "persistence", "strategy"],
  "properties": {
    "replicaCount": {
      "const": 1,
      "description": "SQLite requires exactly one application pod per Helm release."
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean"]
      },
      "propertyNames": {
        "not": {
          "enum": [
            "OIDC_CLIENT_SECRET",
            "SMTP_PASSWORD",
            "WEB_PUSH_PRIVATE_KEY",
            "OWNER_SETUP_TOKEN",
            "RECOVERY_ADMIN_INITIAL_PASSWORD"
          ]
        }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "runtime": {
      "type": "object",
      "required": ["nodeEnv", "host", "port", "databasePath", "backupDir", "tmpDir"],
      "properties": {
        "nodeEnv": { "const": "production" },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "databasePath": { "type": "string", "pattern": "^/[^/]+/.+" },
        "backupDir": { "type": "string", "pattern": "^/" },
        "tmpDir": { "type": "string", "pattern": "^/" }
      }
    },
    "ownerSetupSecret": { "$ref": "#/definitions/secretFile" },
    "recoveryAdminSecret": { "$ref": "#/definitions/secretFile" },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "hosts", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string", "pattern": "^/" },
                    "pathType": { "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "hosts": { "minItems": 1 } } }
        }
      ]
    },
    "persistence": {
      "type": "object",
      "required": ["data", "backups", "tmp"],
      "properties": {
        "data": { "$ref": "#/definitions/persistence" },
        "backups": { "$ref": "#/definitions/persistence" },
        "tmp": {
          "type": "object",
          "required": ["mountPath", "sizeLimit"],
          "properties": {
            "mountPath": { "type": "string", "pattern": "^/" },
            "sizeLimit": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" }
          }
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "Recreate" } }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 10 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "helmTest": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  },
  "definitions": {
    "secretFile": {
      "type": "object",
      "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": { "type": "string" },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "accessModes", "size", "retain", "mountPath"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod"] }
        },
        "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
        "retain": { "type": "boolean" },
        "mountPath": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
