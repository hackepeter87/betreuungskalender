{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": ["replicaCount", "image", "runtime", "database", "service", "ingress", "persistence", "strategy"],
  "properties": {
    "replicaCount": {
      "const": 1,
      "description": "Every supported database mode currently requires exactly one application pod per Helm release."
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean"]
      },
      "propertyNames": {
        "not": {
          "enum": [
            "OIDC_CLIENT_SECRET",
            "SMTP_PASSWORD",
            "WEB_PUSH_PRIVATE_KEY",
            "OWNER_SETUP_TOKEN",
            "RECOVERY_ADMIN_INITIAL_PASSWORD"
          ]
        }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "runtime": {
      "type": "object",
      "required": ["nodeEnv", "host", "port", "databasePath", "backupDir", "tmpDir"],
      "properties": {
        "nodeEnv": { "const": "production" },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "databasePath": { "type": "string", "pattern": "^/[^/]+/.+" },
        "backupDir": { "type": "string", "pattern": "^/" },
        "tmpDir": { "type": "string", "pattern": "^/" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "postgres", "embeddedEvaluation"],
      "properties": {
        "type": {
          "enum": ["sqlite", "postgres-external", "postgres-embedded-evaluation"]
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "database", "user", "passwordSecret", "tls"],
          "properties": {
            "host": { "type": "string", "maxLength": 253 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": { "type": "string", "maxLength": 63 },
            "user": { "type": "string", "maxLength": 63 },
            "passwordSecret": { "$ref": "#/definitions/namedSecretFile" },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "caSecret"],
              "properties": {
                "mode": { "enum": ["disable", "verify-full"] },
                "caSecret": { "$ref": "#/definitions/namedSecretFile" }
              }
            }
          }
        },
        "embeddedEvaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "persistence", "resources"],
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "tag", "pullPolicy"],
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 },
                "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
              }
            },
            "persistence": { "$ref": "#/definitions/evaluationPersistence" },
            "resources": { "type": "object" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "sqlite" } } },
          "then": {
            "properties": {
              "postgres": {
                "properties": {
                  "host": { "maxLength": 0 },
                  "database": { "maxLength": 0 },
                  "user": { "maxLength": 0 },
                  "passwordSecret": { "properties": { "name": { "maxLength": 0 } } },
                  "tls": {
                    "properties": {
                      "caSecret": { "properties": { "name": { "maxLength": 0 } } }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "postgres-external" } } },
          "then": {
            "properties": {
              "postgres": {
                "properties": {
                  "host": { "minLength": 1 },
                  "database": { "minLength": 1 },
                  "user": { "minLength": 1 },
                  "passwordSecret": { "properties": { "name": { "minLength": 1 } } },
                  "tls": {
                    "allOf": [
                      {
                        "if": { "properties": { "mode": { "const": "verify-full" } } },
                        "then": {
                          "properties": {
                            "caSecret": { "properties": { "name": { "minLength": 1 } } }
                          }
                        }
                      },
                      {
                        "if": { "properties": { "mode": { "const": "disable" } } },
                        "then": {
                          "properties": {
                            "caSecret": { "properties": { "name": { "maxLength": 0 } } }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "postgres-embedded-evaluation" } } },
          "then": {
            "properties": {
              "postgres": {
                "properties": {
                  "host": { "maxLength": 0 },
                  "database": { "minLength": 1 },
                  "user": { "minLength": 1 },
                  "passwordSecret": { "properties": { "name": { "minLength": 1 } } },
                  "tls": {
                    "properties": {
                      "mode": { "const": "disable" },
                      "caSecret": { "properties": { "name": { "maxLength": 0 } } }
                    }
                  }
                }
              },
              "embeddedEvaluation": {
                "properties": {
                  "persistence": { "properties": { "enabled": { "const": true } } }
                }
              }
            }
          }
        }
      ]
    },
    "ownerSetupSecret": { "$ref": "#/definitions/secretFile" },
    "recoveryAdminSecret": { "$ref": "#/definitions/secretFile" },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "hosts", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string", "pattern": "^/" },
                    "pathType": { "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "hosts": { "minItems": 1 } } }
        }
      ]
    },
    "persistence": {
      "type": "object",
      "required": ["data", "backups", "tmp"],
      "properties": {
        "data": { "$ref": "#/definitions/persistence" },
        "backups": { "$ref": "#/definitions/persistence" },
        "tmp": {
          "type": "object",
          "required": ["mountPath", "sizeLimit"],
          "properties": {
            "mountPath": { "type": "string", "pattern": "^/" },
            "sizeLimit": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" }
          }
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "Recreate" } }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 10 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "helmTest": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  },
  "definitions": {
    "secretFile": {
      "type": "object",
      "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": { "type": "string" },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
      }
    },
    "namedSecretFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "type": "string", "pattern": "^(|[a-z0-9]([-a-z0-9.]*[a-z0-9])?)$", "maxLength": 253 },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
      }
    },
    "evaluationPersistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "annotations", "retain"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod"] }
        },
        "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
        "annotations": { "type": "object" },
        "retain": { "type": "boolean" }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "accessModes", "size", "retain", "mountPath"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod"] }
        },
        "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
        "retain": { "type": "boolean" },
        "mountPath": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
